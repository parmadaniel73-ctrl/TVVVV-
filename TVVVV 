    ax1.tick_params(axis='y', labelcolor=color)

    ax2 = ax1.twinx()
    color = 'tab:orange'
    ax2.set_ylabel(r'Geometrická deformace $W(\chi)$', color=color, fontsize=12)
    ax2.plot(z_arr_bg, W_vals, color=color, linestyle='-.', linewidth=2, label=r'$W(\chi)$')
    ax2.tick_params(axis='y', labelcolor=color)

    plt.title(r'Evoluce $G_{\mathrm{eff}}/G$ a $W(\chi)$ v závislosti na redshiftu', fontsize=14)
    fig.tight_layout()
    plt.savefig(os.path.join(output_dir, 'tvvvv_geff_w_evolution_0000.png'), dpi=150)
