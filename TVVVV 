def bao_chi2():

    z_star = 1100.0

    rd = r_s_TVVVV(z_star)

    chi_solution = chi_of_z(3.0)

    # ------------------------------
    # veřejné BAO body
    # ------------------------------

    data = [

        # z, typ, hodnota, sigma

        (0.38, "DV", 10.23, 1.02),
        (0.51, "DV", 13.36, 1.18),
        (0.61, "DV", 15.44, 1.20),

        (0.83, "DM", 18.77, 2.35),
        (0.83, "DH", 19.51, 2.05),

        (1.48, "DM", 27.79, 3.54),
        (1.48, "DH", 13.24, 0.96),

        (2.33, "DM", 36.02, 4.30),
        (2.33, "DH", 9.01, 0.25),

    ]

    chi2 = 0.0

    print()
    print("=== BAO CHI2 TEST ===")
    print()

    print(
        "z      | Observable | Data | TVVVV | chi2"
    )

    print("-" * 60)

    for z, kind, obs, sigma in data:

        chi = float(
            chi_solution(z)[0]
        )

        H = H_TVVVV_z(
            z,
            chi
        )

        DM = chi

        DH = c / H

        DV = (
            DM**2
            * (c * z / H)
        )**(1.0/3.0)

        if kind == "DM":
            theory = DM / rd

        elif kind == "DH":
            theory = DH / rd

        else:
            theory = DV / rd

        contrib = (
            (theory - obs)
            / sigma
        )**2

        chi2 += contrib

        print(
            f"{z:4.2f}   "
            f"{kind:>2}   "
            f"{obs:8.3f}   "
            f"{theory:8.3f}   "
            f"{contrib:8.3f}"
        )

    print("-" * 60)

    dof = len(data) - 2

    print()
    print(f"BAO chi2 = {chi2:.3f}")
    print(f"chi2/dof = {chi2/dof:.3f}")
    return chi2


