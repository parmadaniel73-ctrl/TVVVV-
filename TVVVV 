from s8_h0_theta_star_2852026_bezscanu_jwst_tabulka import solve_growth_TVVVV
#=========================================
#LCDM
#=========================================
def E_LCDM(a):
    Omega_r = 9e-5

    Omega_lam = 1.0 - Omega_M - Omega_r

    return np.sqrt(
        Omega_M * a**-3
        + Omega_r * a**-4
        + Omega_lam
    )

def H_LCDM_a(a):
    return H0 * E_LCDM(a)

#=========================================
#LCDM growth equation
#=========================================
def growth_eq_LCDM(a, y):
    delta, ddelta_da = y

    H = H_LCDM_a(a)

    eps = 1e-3

    ap = a * (1.0 + eps)
    am = a * (1.0 - eps)

    Hp = H_LCDM_a(ap)
    Hm = H_LCDM_a(am)

    dlnH_dla = (
        np.log(Hp) - np.log(Hm)
    ) / np.log((1.0 + eps)/(1.0 - eps))

    grav = (
        1.5
        * Omega_M
        * H0**2
        * a**-5
        / H**2
    )

    d2delta_da2 = (
        grav * delta
        - (3.0 + dlnH_dla)
        * ddelta_da / a
    )

    return [ddelta_da, d2delta_da2]

# =========================================
# LCDM solver
# =========================================

def solve_growth_LCDM():

    y0 = [1e-3, 1.0]

    sol = solve_ivp(
        growth_eq_LCDM,
        (1e-3, 1.0),
        y0,
        dense_output=True,
        rtol=1e-6,
        atol=1e-8
    )

    return sol

# =========================================
# Převody
# =========================================

def a_of_z(z):

    return 1.0 / (1.0 + z)

# =========================================
# S8
# =========================================

sigma8_LCDM = 0.83

def compute_S8_TVVVV():

    sol_LCDM = solve_growth_LCDM()

    sol_TVVVV = solve_growth_TVVVV()

    # -------------------------
    # NORMALIZACE
    # -------------------------

    D_LCDM = sol_LCDM.sol(1.0)[0]

    D_TVVVV = sol_TVVVV.sol(1.0)[0]

    ratio = D_TVVVV / D_LCDM

    sigma8_TVVVV = sigma8_LCDM * ratio

    S8_LCDM = (
        sigma8_LCDM
        * np.sqrt(Omega_M / 0.3)
    )

    S8_TVVVV = (
        sigma8_TVVVV
        * np.sqrt(Omega_m / 0.3)
    )

    return (
        S8_LCDM,
        S8_TVVVV,
        D_LCDM,
        D_TVVVV
    )

# =========================================
# fσ8
# =========================================

def f_sigma8_from_sol(
    sol,
    z,
    sigma8_0,
    D0
):

    a = a_of_z(z)

    delta, ddelta_da = sol.sol(a)

    f = (a / delta) * ddelta_da

    sigma8_z = sigma8_0 * delta / D0

    return f * sigma8_z

def compute_fsigma8_TVVVV(z_points):

    sol_LCDM = solve_growth_LCDM()

    sol_TVVVV = solve_growth_TVVVV()

    D_LCDM = sol_LCDM.sol(1.0)[0]

    D_TVVVV = sol_TVVVV.sol(1.0)[0]

    sigma8_TVVVV = (
        sigma8_LCDM
        * D_TVVVV / D_LCDM
    )

    fs8 = []

    for z in z_points:

        val = f_sigma8_from_sol(
            sol_TVVVV,
            z,
            sigma8_TVVVV,
            D_TVVVV
        )

        fs8.append(val)

    return np.array(fs8)

