        chi = float(chi_solution(z)[0])
        H = H_TVVVV_z(z, chi)
        H_si = H / MPC_IN_KM
        return 1.0 / ((1.0 + z) * H_si)

    age_low, _ = quad(integrand_lowz, 0.0, 20.0,
                      epsabs=1e-8, epsrel=1e-8, limit=500)

    def integrand_highz(z):
        H = H_TVVVV_highz(z)                                                                    H_si = H / MPC_IN_KM
